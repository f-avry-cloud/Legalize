{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "framework": null,
  "buildCommand": null,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/index.html",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/api"
    },
    {
      "source": "/depot/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/pdf-parse/**,node_modules/tesseract.js/**,node_modules/tesseract.js-core/**,node_modules/@tesseract.js-data/fra/4.0.0_best_int/**,node_modules/@napi-rs/**,node_modules/wasm-feature-detect/**,node_modules/pdfjs-dist/**}"
    }
  }
}
